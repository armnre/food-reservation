# ── دیتابیس ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── ردیس (در production اجباری) ─────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── رمزنگاری داده (۳۲ بایت، base64) ─────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=

# ── سخت‌گیری Redis در production ────────────────────────
# پیش‌فرض: true در production. فقط وقتی واقعاً Redis در دسترس نیست = false
REDIS_STRICT=true

# ── شبکه / پراکسی ───────────────────────────────────────
# تعداد hop قابل‌اعتماد در انتهای زنجیره X-Forwarded-For
TRUSTED_PROXY_HOPS=0

# ── نشست ────────────────────────────────────────────────
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=hm_sofreh_session

# ── آپلود ───────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── محیط ────────────────────────────────────────────────
NODE_ENV=production
