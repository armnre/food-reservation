{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 110,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "jsxSingleQuote": false,
  "overrides": [
    {
      "files": ["*.md"],
      "options": { "printWidth": 100, "proseWrap": "preserve" }
    },
    {
      "files": ["*.sql"],
      "options": { "parser": "sql" }
    }
  ]
}
